<?xml version="1.0" encoding="utf-8"?>
<!-- MoPlayer — primary Play/Pause control: a bold electric-cyan circle with a
     soft focus halo. Pairs with a dark icon tint for maximum on-TV contrast. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FOCUSED: a halo drawn outside the view bounds is clipped into a dark square, so the
         focus state is a brighter fill with a thick white ring (the pop animator adds the lift). -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/cinematic_cyan_light"
                android:endColor="@color/cinematic_cyan" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>

    <!-- PRESSED -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/cinematic_cyan_dark" />
            <stroke android:width="2dp" android:color="#A6FFFFFF" />
        </shape>
    </item>

    <!-- DEFAULT -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/cinematic_cyan_dark"
                android:endColor="@color/cinematic_cyan" />
            <stroke android:width="1.5dp" android:color="#3DFFFFFF" />
        </shape>
    </item>

</selector>
