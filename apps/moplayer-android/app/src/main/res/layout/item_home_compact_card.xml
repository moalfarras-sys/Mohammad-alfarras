<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardContainer"
    android:layout_width="192dp"
    android:layout_height="72dp"
    android:layout_marginHorizontal="6dp"
    android:focusable="true"
    android:clickable="true"
    android:clipToOutline="true"
    app:cardBackgroundColor="@color/cinematic_bg_elevated"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:strokeWidth="1dp"
    app:strokeColor="@color/liquid_glass_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/ivPoster"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:background="@color/cinematic_bg_base" />
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:fontFamily="@font/ui_body_medium"
            android:textColor="@color/cinematic_text_primary"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textDirection="locale"
            android:gravity="start" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/progressWatch"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:max="100"
        android:visibility="gone" />
</com.google.android.material.card.MaterialCardView>
