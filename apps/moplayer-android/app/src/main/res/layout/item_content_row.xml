<?xml version="1.0" encoding="utf-8"?>
<!-- Compact Home rail; three shelves fit above the dock, including the large interface size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="0dp"
    android:paddingBottom="4dp">

    <!-- Row Title -->
    <TextView
        android:id="@+id/tvRowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin_horizontal"
        android:layout_marginBottom="4dp"
        android:textColor="@color/cinematic_text_primary"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textStyle="bold"
        android:fontFamily="@font/outfit"
        android:letterSpacing="0.01"
        android:alpha="1"
        tools:text="New Movies" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRowItems"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingStart="@dimen/screen_margin_horizontal"
        android:paddingEnd="@dimen/screen_margin_horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:orientation="horizontal"
        tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_home_compact_card" />

</LinearLayout>
